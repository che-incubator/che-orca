# Image registry that you can push to and workspace pods can pull from.
ORCA_IMAGE=quay.io/my-org/devspaces-orca-editor:latest
# Required: your Dev Spaces user namespace. Check it with `oc project -q`.
NAMESPACE=
# Optional: KServe model namespace. Leave empty to skip discovery.
# The workspace service account needs access to this namespace and its models.
REDHAT_AI_NAMESPACE=
# Optional: leave empty unless you use Google Vertex AI.
GOOGLE_CLOUD_PROJECT=
CLOUD_ML_REGION=us-central1
# For manual editor registration; deploy.sh calculates this from its Route.
# ORCA_PAIRING_ADDRESS=wss://orca.example.com/
